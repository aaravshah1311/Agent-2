# Author: Aarav Shah
# Keep the build context small and reproducible. The image builds its own
# .venv and its own DB volume — never copy the host's in.

# Virtual environments (image builds a fresh one)
.venv/
venv/
env/

# Nested self-clone created by install.py / run.py --update
Agent-2/

# ⚠️ The host's state, which is what line 3 promises never to copy in. The image
# builds its own DB on the /data volume (AGENT2_DB), so a host agent2.db in the
# build context is baked into every layer of the image — API keys, memories and
# the whole chat history — and stays there in any image that is pushed or shared.
# Inert at runtime and invisible, which is exactly why it needs a rule.
agent2.db
agent2.db-wal
agent2.db-shm
agent2.db-journal
*.sqlite
*.sqlite3
.env
.env.migrated

# Logs are written next to the DB and are per-machine
logs/

# Python caches
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# VCS / editor / OS cruft
.git/
.gitignore
.vscode/
.idea/
.DS_Store
Thumbs.db

# Docs / marketing site not needed at runtime
website/
pic/

# Docker files themselves
Dockerfile
docker-compose.yml
.dockerignore
